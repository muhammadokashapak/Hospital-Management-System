# Database Configuration (PostgreSQL / SQLite)
# For production PostgreSQL: postgresql+psycopg2://postgres:password@localhost:5432/hospital_db
DATABASE_URL=sqlite:///./hospital_db.sqlite3

# Security Secrets
SECRET_KEY=replace_with_a_secure_random_production_secret_key_min_32_chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# File Upload Storage Directory
UPLOAD_DIR=./uploads

# Environment
ENVIRONMENT=production
